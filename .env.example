# ============================================================
# Voice-Enabled RAG System — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ── Sarvam AI ─────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_MODEL=saaras:v3-realtime

# ── Qdrant ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # Leave empty for local dev
QDRANT_COLLECTION_NAME=msmarco_xi_rag
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_HNSW_EF_QUERY=64

# ── vLLM / LLM ─────────────────────────────────────────────
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_MAX_TOKENS=256
VLLM_TEMPERATURE=0.1

# ── Embedding ──────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cuda                  # cuda | cpu | mps

# ── Reranker ───────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=50                      # Candidates fed to reranker
RERANKER_OUTPUT_K=10                   # After reranking, keep top-N
RERANKER_CONFIDENCE_THRESHOLD=0.5

# ── Guardrails ─────────────────────────────────────────────
TOPIC_CLASSIFIER_MODEL=facebook/bart-large-mnli
SAFETY_MODEL=unitary/toxic-bert
NLI_MODEL=cross-encoder/nli-deberta-v3-base
GROUNDING_THRESHOLD=0.6
TOXICITY_THRESHOLD=0.7

# ── Chunking ───────────────────────────────────────────────
CHILD_CHUNK_MIN_TOKENS=128
CHILD_CHUNK_MAX_TOKENS=256
PARENT_CHUNK_MIN_TOKENS=512
PARENT_CHUNK_MAX_TOKENS=1024
CHUNK_OVERLAP_PERCENT=0.12
SEMANTIC_SPLIT_THRESHOLD=0.65

# ── Ingestion ──────────────────────────────────────────────
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_LANGUAGES=hi,ta,te,bn,mr,gu,kn,ml,pa,or,as,ur
DATASET_INGEST_LIMIT=5000              # Queries per language

# ── API ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
LOG_LEVEL=INFO

# ── HuggingFace ────────────────────────────────────────────
HF_TOKEN=                              # Optional, for gated models
HF_HOME=/tmp/hf_cache
